PORT=5000
# Copy the pooled or direct PostgreSQL connection string from Neon Console.
# Example: postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_ENDPOINT.neon.tech/neondb?sslmode=require
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5000
